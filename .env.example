# Copy this file to .env.local and fill in a NEW Firebase web app config.
# Leave these empty until you are ready to connect a new project.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Supabase publishable key only. Never put the service-role key here.
# The live site reads these from .env.production during the Vercel build.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
